#!/bin/sh
# Triggr is arm64-only for now: its A12+ (arm64e) builds used an ABI that
# crashes on iOS 15-16, so new installs on A12 and newer devices are refused.
# Upgrades are allowed so an older, crashing version can be replaced (this
# build simply doesn't load on A12+).
[ "$1" = "install" ] || [ "$1" = "upgrade" ] || exit 0
model=""
for u in uname /var/jb/usr/bin/uname /usr/bin/uname; do
    model="$($u -m 2>/dev/null)" && [ -n "$model" ] && break
done
major=""
case "$model" in
    iPhone*) major="${model#iPhone}"; major="${major%%,*}"; limit=11 ;;
    iPad*) major="${model#iPad}"; major="${major%%,*}"; limit=8 ;;
esac
case "$major" in ''|*[!0-9]*) exit 0 ;; esac
[ "$major" -ge "$limit" ] || exit 0
if [ "$1" = "install" ]; then
    echo "Triggr doesn't support A12 and newer devices ($model) yet: earlier builds put them into safe mode. Follow the repo for an update."
    exit 1
fi
echo "Note: Triggr doesn't run on A12 and newer devices ($model) yet. This update replaces the build that caused safe mode; you can uninstall it."
exit 0
